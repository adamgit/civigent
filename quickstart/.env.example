# Port the web UI is served on (host-facing port)
PORT=8080

# KS_EXTERNAL_PORT is set automatically in compose.yaml from PORT above.
# It tells the backend which port users actually connect on (for startup messages
# and OAuth URL auto-detection). You should NOT need to set this manually.
# KS_EXTERNAL_PORT=8080

# UID/GID for file ownership (default: 1000, the first non-root user on most systems)
UID=1000
GID=1000

# Import existing markdown on first startup (when wiki-data/content is empty)
# IMPORT_CONTENT_FROM=/path/to/your/markdown

# IMPORTANT: quickstart uses host bind mounts. Before first start, manually
# create ./wiki-data, ./snapshots, and ./backup-secrets on the host. Ensure
# wiki-data and snapshots are writable by the container process.
# backup-secrets/ may stay empty until you enable private Git remote backup.
#
# Snapshot cache: generated markdown files are written to ./snapshots on the host
# by default. To disable snapshots entirely, set this to false.
KS_SNAPSHOT_ENABLED=true

# Optional: override the in-container snapshot path. If you change this,
# update the snapshots bind mount in compose.yaml to match.
# KS_SNAPSHOT_ROOT=/app/snapshots

# Optional: force single-user mode (no external auth provider/account setup)
# Leave commented for default auth-provider mode.
# KS_AUTH_MODE=single_user
# KS_USER_NAME=Local User
# KS_USER_EMAIL=local-user@ks.local
# KS_USER_ID=human-ui

# Optional: human-facing name for this install (browser tab titles, etc.).
# Distinct from the per-user MCP server name on the setup page.
# When unset, falls back to getPublicUrl() (KS_EXTERNAL_HOSTNAME + KS_EXTERNAL_PORT).
# KS_APP_NAME=Acme Wiki

# SSO / OIDC login (see docs/sso-setup.md for provider-specific instructions)
# KS_AUTH_MODE=oidc
# KS_OIDC_PUBLIC_URL=https://your-civigent-domain
# KS_OIDC_ISSUER=https://accounts.google.com
# KS_OIDC_CLIENT_ID=your-client-id
# KS_OIDC_CLIENT_SECRET=your-client-secret
# KS_OIDC_DISPLAY_NAME=Sign in with Google
#
# MCP agent OAuth URL override.
# Use this when agents must reach Civigent at a different public base URL than browser users.
# Do not set this together with KS_MCP_PUBLIC_URL_FROM_HEADERS.
# KS_MCP_PUBLIC_URL=https://agent-auth.example.com
#
# Derive MCP OAuth URLs from trusted proxy/request headers instead of a fixed URL.
# Only use this behind a trusted proxy that overwrites forwarded headers.
# Do not set this together with KS_MCP_PUBLIC_URL.
# KS_MCP_PUBLIC_URL_FROM_HEADERS=true

# Agent auth policy: open | approve | confidential. Any other value fails startup.
# Default: open on localhost, confidential on a public hostname.
#   open         — agents self-register anonymously
#   approve      — self-register plus a signed-in human approves each agent's first
#                  connection in the browser (incompatible with KS_AUTH_MODE=single_user —
#                  that combination refuses startup)
#   confidential — admin-created identity + client secret required at the token endpoint
# KS_AGENT_AUTH_POLICY=open

# Governance mode: "available" (toggle in UI) or "forced" (always governance view)
# KS_GOVERNANCE_MODE=available

# Fatal-error policy: what to do after a process-level invariant failure.
#   report — keep the process running and surface the error to connected clients
#            (accepts continued availability with the risk of further corruption)
#   crash  — exit the process so your orchestrator/supervisor can restart it
# Default when unset: report.
# KS_FATAL_ERRORS_MODE=report

# Private Git remote backup (optional).
# compose.yaml mounts ./backup-secrets → /run/secrets/civigent_backup and owns the
# in-container credential paths. Do NOT set KS_BACKUP_SSH_KEY_PATH,
# KS_BACKUP_KNOWN_HOSTS_PATH, or SSH_AUTH_SOCK here.
#
# Host files (when enabling ssh-key mode):
#   ./backup-secrets/civigent_backup_ssh_key
# See docs/backup-restore.md or /admin/git-backup.
#
# KS_BACKUP_GIT_REMOTE=git@<forge-host>:<owner>/<repo>.git
# KS_BACKUP_GIT_AUTH_MODE=ssh-key
#
# Or ssh-agent mode (host must export SSH_AUTH_SOCK when you run compose):
# KS_BACKUP_GIT_REMOTE=git@<forge-host>:<owner>/<repo>.git
# KS_BACKUP_GIT_AUTH_MODE=ssh-agent
#
# Optional host-key pinning (off unless you opt in): set the flag below to true
# AND place the file ./backup-secrets/civigent_backup_known_hosts. When the flag
# is omitted, pinning stays off and no known_hosts path is claimed. Do NOT set
# it to false to disable — compose `:+` substitution treats any non-empty value
# (including "false") as enabled; omit the variable instead.
# KS_BACKUP_KNOWN_HOSTS_ENABLED=true

# Claude Code public skills plugin (optional overrides; invalid values fail startup).
# Serves a plugin ZIP at /exported/<zip name> for:
#   claude --plugin-url https://<host>/exported/skills.zip
# Invoke commands/skills as /<plugin name>:<name> (Claude Code ≥ v2.1.128).
# Export is canonical/published content only — not live/workspace drafts.
# KS_EXPORTEDSKILLS_PLUGIN_NAME=civ          # lowercase kebab-case, no spaces
# KS_EXPORTEDSKILLS_ZIP_NAME=skills.zip      # single path segment [A-Za-z0-9._-]+
# KS_EXPORTEDSKILLS_FOLDER=/public_skills    # leading /, no trailing /
