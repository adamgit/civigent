{
    "name": "Node.js + TypeScript",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "remoteUser": "node",
    "customizations": {
        "vscode": {
            "settings": {
                "remote.autoForwardPortsSource": "process"
            }
        }
    },
    "runArgs": ["--add-host=host.docker.internal:host-gateway"]
}
